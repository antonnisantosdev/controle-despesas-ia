# Copia este ficheiro para .env.local.
# Endereço da API em FastAPI. O prefixo NEXT_PUBLIC_ deixa o valor chegar ao browser,
# por isso aqui nunca se põem segredos (chaves, palavras-passe).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Contactos para o botão "Pedir acesso" (páginas /precos e /plano). Também são públicos.
# WhatsApp: só dígitos, em formato internacional (ex.: 351 + número). Vazio = não aparece.
NEXT_PUBLIC_CONTACTO_WHATSAPP=
# Email para os pedidos de plano. Vazio = não aparece. Sem nenhum dos dois, o botão fica desativado.
NEXT_PUBLIC_CONTACTO_EMAIL=
