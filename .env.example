# Copia este ficheiro para .env e preenche com os valores do teu projeto Supabase.
# O .env nunca vai para o GitHub; este .env.example vai, mas sem valores reais.

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://o-teu-projeto.supabase.co

# Supabase > Project Settings > API Keys > Secret key (começa por sb_secret_)
# É secreta: só a API a usa, nunca o frontend.
SUPABASE_KEY=

# IA: qual fornecedor usar (por agora só existe "claude").
IA_FORNECEDOR=claude

# Claude Console (platform.claude.com) > API Keys > Create Key (começa por sk-ant-)
ANTHROPIC_API_KEY=
# Modelo do Claude. O Haiku é o mais barato e chega para categorizar.
CLAUDE_MODELO=claude-haiku-5-5

# Endereço(s) do frontend que podem chamar a API (CORS), separados por vírgula.
FRONTEND_URL=http://localhost:3000

# Demo para recrutadores (POST /demo). Sem as 3 variáveis, a demo fica desligada.
# Segredo do token da demo: no mínimo 32 caracteres. Gerar no terminal com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DEMO_TOKEN_SEGREDO=
# Supabase > Authentication > Users > a conta de demo > User UID
DEMO_USER_ID=
# O email dessa conta (a API confirma que o id é desta conta antes de repor os dados).
DEMO_EMAIL=

# Interruptor do Brasil (perfil.py). Até haver termos e política para a LGPD fica fechado:
# só escolhe "vivo no Brasil" quem tem o id da conta em BRASIL_TESTERS (separados por vírgulas)
# ou quem já o tinha. BRASIL_ABERTO=true abre a toda a gente.
BRASIL_ABERTO=false
BRASIL_TESTERS=
