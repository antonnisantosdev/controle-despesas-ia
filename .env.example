# Copia este ficheiro para .env e preenche com os valores do teu projeto Supabase.
# O .env nunca vai para o GitHub; este .env.example vai, mas sem valores reais.

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://o-teu-projeto.supabase.co

# Supabase > Project Settings > API Keys > Secret key (começa por sb_secret_)
# É secreta: só a API a usa, nunca o frontend.
SUPABASE_KEY=

# IA: qual fornecedor usar (por agora só existe "claude").
IA_FORNECEDOR=claude

# Claude Console (platform.claude.com) > API Keys > Create Key (começa por sk-ant-)
ANTHROPIC_API_KEY=
# Modelo do Claude. O Haiku é o mais barato e chega para categorizar.
CLAUDE_MODELO=claude-haiku-5-5
