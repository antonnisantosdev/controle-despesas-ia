# Copia este ficheiro para .env e preenche com os valores do teu projeto Supabase.
# O .env nunca vai para o GitHub; este .env.example vai, mas sem valores reais.

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://o-teu-projeto.supabase.co

# Supabase > Project Settings > API Keys > Secret key (começa por sb_secret_)
# É secreta: só a API a usa, nunca o frontend.
SUPABASE_KEY=
