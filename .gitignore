# Ambiente virtual do Python (cada pessoa cria o seu com pip install)
.venv/

# Cache que o Python gera automaticamente ao correr o código
__pycache__/
*.pyc

# Segredos: chaves de API, palavras-passe do Supabase, etc.
.env
.env.*
!.env.example

# Definições locais do Claude Code (pessoais, não são do projeto)
.claude/settings.local.json
.claude/launch.json
CLAUDE.md
# Os agentes do Claude Code são privados: ficam só neste computador.
.claude/agents/

# Lixo do sistema operativo e do editor
.DS_Store
Thumbs.db
.vscode/

# Fotografias reais (talões) nunca vão para o GitHub
dados_exemplo/*.jpg
dados_exemplo/*.jpeg
dados_exemplo/*.heic
dados_exemplo/WhatsApp*

# Ficheiros temporários do playwright-cli
.playwright-cli/
